{
  "name": "commercehub-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5301",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 5301",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,mjs}\" \"tests/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"*.ts\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,mjs}\" \"tests/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"*.ts\" \"*.mjs\"",
    "test:unit": "jest --coverage --runInBand",
    "test:identity": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/lib/synthetic-identity.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
