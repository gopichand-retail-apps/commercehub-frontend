# Public build-time mode selection. The source default is true.
NEXT_PUBLIC_IS_MOCK=true

# Server-side API origins used by Next.js rewrites. Do not put credentials here.
COMMERCEHUB_MOCK_API_URL=http://127.0.0.1:5302
COMMERCEHUB_REAL_API_URL=

# Legacy local-development fallback; prefer the explicit mode-specific origins above.
COMMERCEHUB_API_URL=http://127.0.0.1:5302
